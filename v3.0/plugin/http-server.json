{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://www.krakend.io/schema/v3.0/plugin/http-server.json",
  "title": "HTTP Server plugins",
  "description": "Enterprise only. Inject your own Go HTTP server plugins, executed in the router layer.\n\nSee: https://www.krakend.io/docs/enterprise/extending/http-server-plugins/",
  "type": "object",
  "required": [ "plugins" ],
  "properties": {
    "plugins": {
      "title": "Plugins",
      "description": "The list of plugins to load, each one with its own configuration.\n\nSee: https://www.krakend.io/docs/enterprise/extending/http-server-plugins/",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/plugin"
      }
    }
  },
  "patternProperties": {
    "^[@$_#]": true
  },
  "additionalProperties": false,
  "$defs": {
    "plugin": {
      "title": "Plugin",
      "description": "A plugin to load and its configuration.\n\nSee: https://www.krakend.io/docs/enterprise/extending/http-server-plugins/",
      "type": "object",
      "allOf": [
        {
          "if": {
            "required": [ "name" ],
            "properties": {
              "name": {
                "const": "geoip"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "geoip.json"
              }
            }
          }
        },
        {
          "if": {
            "required": [ "name" ],
            "properties": {
              "name": {
                "const": "ip-filter"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "ip-filter.json"
              }
            }
          }
        },
        {
          "if": {
            "required": [ "name" ],
            "properties": {
              "name": {
                "const": "jwk-aggregator"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "jwk-aggregator.json"
              }
            }
          }
        },
        {
          "if": {
            "required": [ "name" ],
            "properties": {
              "name": {
                "const": "redis-ratelimit"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "deprecated": true,
                "$ref": "redis-ratelimit.json"
              }
            }
          }
        },
        {
          "if": {
            "required": [ "name" ],
            "properties": {
              "name": {
                "const": "url-rewrite"
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "$ref": "url-rewrite.json"
              }
            }
          }
        }
      ],
      "if": {
        "required": [ "name" ],
        "properties": {
          "name": {
            "const": "wildcard"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "deprecated": true,
            "$ref": "wildcard.json"
          }
        }
      },
      "required": [ "name" ],
      "properties": {
        "config": {
          "title": "Plugin configuration",
          "description": "The configuration passed to the plugin. Its content depends on each plugin.\n\nSee: https://www.krakend.io/docs/enterprise/extending/http-server-plugins/",
          "type": "object"
        },
        "name": {
          "title": "Plugin name",
          "description": "The name of the plugin to load. It must match the name your plugin registers.\n\nSee: https://www.krakend.io/docs/enterprise/extending/http-server-plugins/",
          "examples": [ "myplugin" ],
          "type": "string"
        },
        "on_load_error": {
          "$ref": "plugin.json#/$defs/on_load_error"
        }
      },
      "patternProperties": {
        "^[@$_#]": true
      },
      "additionalProperties": false
    }
  }
}
