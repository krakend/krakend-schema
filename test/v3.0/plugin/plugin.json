{
  "description": "Plugins",
  "target": "https://www.krakend.io/schema/v3.0/krakend.json",
  "tests": [
    {
      "description": "new plugin configuration",
      "data": {
        "version": 3,
        "host": [
          "http://localhost:8080"
        ],
        "extra_config": {
          "plugin": {
            "pattern": ".so",
            "folder": "/etc/krakend/plugins",
            "on_load_default_error": "critical"
          },
          "plugin/http-server": {
            "plugins": [
              {
                "name": "server-test",
                "on_load_error": "passthrough",
                "config": {
                  "key": "value"
                }
              }
            ]
          }
        },
        "endpoints": [
          {
            "endpoint": "/",
            "backend": [
              {
                "url_pattern": "/__echo/",
                "extra_config": {
                  "plugin/http-client": {
                    "name": "client-test",
                    "config": {
                      "some": "config"
                    }
                  }
                }
              }
            ],
            "extra_config": {
              "plugin/req-resp-modifier": {
                "plugins": [
                  {
                    "name": "ip-filter",
                    "config": {
                      "allow": true,
                      "CIDR": [
                        "1.2.3.4/32"
                      ]
                    }
                  },
                  {
                    "name": "modifier-test-request",
                    "config": {
                      "option": "for-request-option"
                    }
                  },
                  {
                    "name": "modifier-test-response",
                    "config": {
                      "option": "for-response-option"
                    }
                  }
                ]
              },
              "plugin/middleware": {
                "plugins": [
                  {
                    "name": "mw-test",
                    "on_load_error": "error",
                    "config": {
                      "variable": "value"
                    }
                  }
                ]
              }
            }
          }
        ]
      },
      "valid": true
    },
