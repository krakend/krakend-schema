            }
          }
        ]
      },
      "valid": false
    },
    {
      "description": "Non integer cost_quality_tradeoff",
      "data": {
        "classifiers": [
          {
            "name": "smart",
            "engine": "notdiamond",
            "notdiamond": {
              "credentials": "xxx",
