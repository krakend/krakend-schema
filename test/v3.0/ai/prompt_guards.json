    {
      "description": "All guard kinds",
      "data": {
        "guards": [
          {
            "name": "block_jailbreak_terms",
            "kind": "regex",
            "severity": "high",
            "config": {
              "patterns": [
                "(?i)ignore (all )?previous instructions",
                "(?i)disregard .*(system )?prompt"
              ]
            }
          },
          {
            "name": "block_sensitive_terms",
            "kind": "regex",
            "severity": "medium",
            "config": {
              "patterns": [
                "(?i)reveal .*(system )?prompt",
                "(?i)you are now .*(DAN|jailbroken)"
              ]
            }
          },
          {
            "name": "injection_classifier",
            "kind": "classifier",
            "severity": "high",
            "config": {
              "score_threshold": 0.6,
              "on_failure_block": false,
              "url": "https://example.com/classify"
            }
          },
          {
            "name": "payload_policy",
            "kind": "policy",
            "severity": "medium",
            "config": {
              "expressions": [
                "meta.method == 'POST'",
                "size(body) <= 8192"
              ]
            }
          }
        ]
      },
      "valid": true
